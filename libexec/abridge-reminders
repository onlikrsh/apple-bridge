#!/usr/bin/env python3
"""Apple Reminders from the Linux command line, on top of pyicloud.

Upgraded iCloud Reminders (iOS 13 and later) live in a private CloudKit
database, not CalDAV, so no Linux calendar or task app can see them. This
talks to that database through pyicloud and adds:

  * name-based list selection and short ids, so you never paste a UUID;
  * a one-way mirror of every reminder into a vdir of VTODO .ics files, which
    todoman (and anything else that reads vdirs) can display offline;
  * CloudKit sync tokens for the list of lists and for the mirror, so a run
    where little changed costs a request or two, not a full download.

bin/abridge runs this with the apple-bridge venv's python, which has pyicloud.
"""

from __future__ import annotations

import argparse
import base64
import gzip
import json
import os
import re
import subprocess
import sys
import time
import uuid
import zlib
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from types import SimpleNamespace
from typing import Any, Callable, Iterable

PRIORITIES = {"none": 0, "high": 1, "medium": 5, "low": 9}
MIRROR_MARKER = ".abridge-mirror"
MIRROR_STATE = ".abridge-sync.json"  # in the mirror; todoman's `dir/*` glob skips it
FULL_REFRESH = 24 * 3600  # seconds between full fetches, in case a token ever misses something
LIST_FIELDS = ("id", "title", "color", "count", "deleted", "is_group")
REMINDER_PREFIX = "Reminder/"
LIST_PREFIX = "List/"
FULL_ID = re.compile(r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}")


class UserError(Exception):
    """A problem the user can fix; printed without a traceback."""


# --------------------------------------------------------------------- ids


def bare_id(record_id: str) -> str:
    """'Reminder/ABC-123' -> 'ABC-123'."""
    return record_id.split("/", 1)[1] if "/" in record_id else record_id


def short_id(record_id: str) -> str:
    return bare_id(record_id)[:8]


def resolve_list(lists: Iterable[Any], query: str) -> Any:
    """Pick a list by exact title, then title prefix, then id (all case-insensitive)."""
    lists = list(lists)
    q = query.casefold()
    for match in (
        lambda l: l.title.casefold() == q,
        lambda l: l.title.casefold().startswith(q),
        lambda l: bare_id(l.id).casefold().startswith(q),
    ):
        hits = [l for l in lists if match(l)]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            names = ", ".join(sorted(l.title for l in hits))
            raise UserError(f'"{query}" matches several lists: {names}')
    names = ", ".join(sorted(l.title for l in lists)) or "(none)"
    raise UserError(f'no list matches "{query}". Lists: {names}')


def resolve_reminder(reminders: Iterable[Any], query: str) -> Any:
    """Pick a reminder by full id or by a prefix of its bare id."""
    q = bare_id(query.strip()).casefold()
    if not q:
        raise UserError("empty reminder id")
    hits = [r for r in reminders if bare_id(r.id).casefold().startswith(q)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise UserError(f"no reminder has an id starting with {query}")
    raise UserError(f"{query} is ambiguous ({len(hits)} reminders); use more characters")


# ------------------------------------------------------------------- dates


def local_tz_name() -> str | None:
    """The IANA name of the system time zone, e.g. 'Asia/Kolkata'."""
    tz = os.environ.get("TZ", "").lstrip(":")
    # Any zone name the system knows ("Asia/Kolkata", "UTC"): times were
    # computed in it, so it has to be the label too.
    if tz and not tz.startswith("/") and ("/" in tz or (Path("/usr/share/zoneinfo") / tz).is_file()):
        return tz
    try:
        target = os.readlink("/etc/localtime")
    except OSError:
        return None
    marker = "zoneinfo/"
    return target.split(marker, 1)[1] if marker in target else None


def parse_due(text: str, today: date | None = None) -> tuple[datetime, bool, str | None]:
    """Parse a --due value into (utc datetime, all_day, time zone name).

    Matches how Apple stores due dates in CloudKit: an all-day reminder is
    00:00 UTC on the literal date with no time zone, a timed one is a real
    instant plus the IANA zone it was set in.
    """
    today = today or date.today()
    value = text.strip()
    relative = {"today": 0, "tomorrow": 1}
    if value.lower() in relative:
        d = today + timedelta(days=relative[value.lower()])
        return datetime(d.year, d.month, d.day, tzinfo=timezone.utc), True, None
    try:
        if len(value) == 10:
            d = date.fromisoformat(value)
            return datetime(d.year, d.month, d.day, tzinfo=timezone.utc), True, None
        moment = datetime.fromisoformat(value.replace(" ", "T", 1))
    except ValueError as err:
        raise UserError(
            f'cannot read due date "{text}"; use YYYY-MM-DD, "YYYY-MM-DD HH:MM", today or tomorrow'
        ) from err
    if moment.tzinfo is None:
        moment = moment.astimezone()  # naive means local wall-clock time
    return moment.astimezone(timezone.utc), False, local_tz_name()


def aware(moment: datetime) -> datetime:
    """pyicloud returns UTC-aware datetimes; treat any naive one as UTC too."""
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


def due_label(reminder: Any) -> str:
    if reminder.due_date is None:
        return ""
    due = aware(reminder.due_date)
    if reminder.all_day:
        return due.astimezone(timezone.utc).date().isoformat()
    return due.astimezone().strftime("%Y-%m-%d %H:%M")


# ------------------------------------------------------------------ VTODO


def ical_escape(text: str) -> str:
    return (
        text.replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\r\n", "\\n")
        .replace("\n", "\\n")
        .replace("\r", "\\n")
    )


def fold(line: str) -> str:
    """Fold a content line at 75 octets (RFC 5545 3.1) without splitting UTF-8."""
    out, current, size = [], "", 0
    for ch in line:
        width = len(ch.encode("utf-8"))
        if size + width > 75:
            out.append(current)
            current, size = " ", 1
        current += ch
        size += width
    out.append(current)
    return "\r\n".join(out)


def ical_utc(moment: datetime) -> str:
    return aware(moment).astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def ical_due(name: str, moment: datetime, all_day: bool) -> str:
    if all_day:
        return f"{name};VALUE=DATE:{aware(moment).astimezone(timezone.utc).strftime('%Y%m%d')}"
    return f"{name}:{ical_utc(moment)}"


def to_vtodo(reminder: Any, list_title: str) -> str:
    """Render one reminder as a complete VCALENDAR object."""
    stamp = reminder.modified or reminder.created or datetime(1970, 1, 1, tzinfo=timezone.utc)
    props = [
        f"UID:{bare_id(reminder.id)}",
        f"DTSTAMP:{ical_utc(stamp)}",
        f"SUMMARY:{ical_escape(reminder.title or '')}",
    ]
    if reminder.desc:
        props.append(f"DESCRIPTION:{ical_escape(reminder.desc)}")
    if reminder.start_date:
        props.append(ical_due("DTSTART", reminder.start_date, reminder.all_day))
    if reminder.due_date:
        props.append(ical_due("DUE", reminder.due_date, reminder.all_day))
    if reminder.completed:
        props.append("STATUS:COMPLETED")
        if reminder.completed_date:
            props.append(f"COMPLETED:{ical_utc(reminder.completed_date)}")
    else:
        props.append("STATUS:NEEDS-ACTION")
    # Apple and RFC 5545 agree: 1 is highest, 5 medium, 9 lowest, 0 undefined.
    if reminder.priority:
        props.append(f"PRIORITY:{reminder.priority}")
    categories = [list_title] + (["Flagged"] if reminder.flagged else [])
    props.append("CATEGORIES:" + ",".join(ical_escape(c) for c in categories))
    if reminder.parent_reminder_id:
        props.append(f"RELATED-TO;RELTYPE=PARENT:{bare_id(reminder.parent_reminder_id)}")
    if reminder.created:
        props.append(f"CREATED:{ical_utc(reminder.created)}")
    if reminder.modified:
        props.append(f"LAST-MODIFIED:{ical_utc(reminder.modified)}")
    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//apple-bridge//Reminders mirror//EN",
        "BEGIN:VTODO",
        *props,
        "END:VTODO",
        "END:VCALENDAR",
    ]
    return "\r\n".join(fold(line) for line in lines) + "\r\n"


def list_color(raw: str | None) -> str | None:
    """Reminders stores colours as JSON like {"daHexString": "#1BADF8", ...}."""
    if not raw:
        return None
    raw = raw.strip()
    if raw.startswith("#") and len(raw) in (7, 9):
        return raw
    if raw.startswith("{"):
        try:
            value = json.loads(raw).get("daHexString")
        except (ValueError, AttributeError):
            return None
        if isinstance(value, str) and value.startswith("#"):
            return value
    return None


# ------------------------------------------------------------------ mirror


def write_if_changed(path: Path, content: str) -> bool:
    data = content.encode("utf-8")
    try:
        if path.read_bytes() == data:
            return False
    except FileNotFoundError:
        pass
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")  # unique: the app and the timer can overlap
    tmp.write_bytes(data)
    os.replace(tmp, path)
    return True


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text("utf-8"))
    except (OSError, ValueError):
        return None


def collections(lists: list[Any], dest: Path) -> dict[str, tuple[Any, Path, bool]]:
    """Give each list its collection directory, and delete those of lists that
    are gone. Returns {bare list id: (list, directory, renamed)}; `renamed` is
    also true for a directory that is new, since either way its files need
    rewriting (every VTODO carries the list name).

    Directories are named by list id so a rename on the phone doesn't move
    files around. Only directories this tool created are ever deleted.
    """
    if dest.exists() and any(dest.iterdir()) and not (dest / MIRROR_MARKER).exists():
        raise UserError(f"{dest} is not empty and is not an apple-bridge mirror; refusing to write there")
    dest.mkdir(parents=True, exist_ok=True)
    (dest / MIRROR_MARKER).touch()

    out = {}
    for reminder_list in lists:
        coll = dest / bare_id(reminder_list.id)
        coll.mkdir(exist_ok=True)
        (coll / MIRROR_MARKER).touch()
        renamed = write_if_changed(coll / "displayname", reminder_list.title)
        color = list_color(reminder_list.color)
        if color:
            write_if_changed(coll / "color", color)
        out[coll.name] = (reminder_list, coll, renamed)

    for coll in dest.iterdir():
        if coll.is_dir() and coll.name not in out and (coll / MIRROR_MARKER).exists():
            for child in coll.iterdir():
                child.unlink()
            coll.rmdir()
    return out


def copy_list(coll: Path, reminder_list: Any, reminders: list[Any], stats: dict[str, int]) -> None:
    """Make `coll` hold exactly `reminders`."""
    keep_files = set()
    for reminder in reminders:
        name = f"{bare_id(reminder.id)}.ics"
        keep_files.add(name)
        if write_if_changed(coll / name, to_vtodo(reminder, reminder_list.title)):
            stats["written"] += 1
        else:
            stats["unchanged"] += 1
    for stale in coll.glob("*.ics"):
        if stale.name not in keep_files:
            stale.unlink()
            stats["removed"] += 1


def mirror(snapshot: list[tuple[Any, list[Any]]], dest: Path) -> dict[str, int]:
    """Make `dest` an exact copy of `snapshot`, a list of (list, reminders).

    One collection directory per list, with vdir `displayname` and `color`
    metadata, and one .ics file per reminder.
    """
    colls = collections([l for l, _ in snapshot], dest)
    stats = {"lists": len(colls), "written": 0, "removed": 0, "unchanged": 0}
    for reminder_list, reminders in snapshot:
        copy_list(colls[bare_id(reminder_list.id)][1], reminder_list, reminders, stats)
    return stats


def mirror_changes(lists: list[Any], changes: list[Any], dest: Path, fetch: Callable[[Any], list[Any]]) -> dict[str, int]:
    """Bring a mirror made by mirror() up to date with pyicloud change events
    (type "updated" or "deleted", reminder_id, reminder).

    A list that is new here or was renamed is copied whole with
    `fetch(list)`; every other list only gets the files that changed.
    """
    colls = collections(lists, dest)
    stats = {"lists": len(colls), "written": 0, "removed": 0, "unchanged": 0}
    whole = {lid for lid, (_, _, renamed) in colls.items() if renamed}
    for lid in whole:
        reminder_list, coll, _ = colls[lid]
        copy_list(coll, reminder_list, fetch(reminder_list), stats)

    written = set()
    for change in changes:
        r = change.reminder
        home = None
        if change.type == "updated" and r is not None and not r.deleted:
            home = bare_id(r.list_id or "")
        name = f"{bare_id(change.reminder_id)}.ics"
        for lid, (reminder_list, coll, _) in colls.items():
            if lid in whole:
                continue
            path = coll / name
            if lid == home:
                if write_if_changed(path, to_vtodo(r, reminder_list.title)):
                    written.add(path)
            elif path.exists():  # deleted, or moved to another list
                path.unlink()
                written.discard(path)
                stats["removed"] += 1

    stats["written"] += len(written)
    for lid, (_, coll, _) in colls.items():
        if lid not in whole:
            stats["unchanged"] += sum(1 for p in coll.glob("*.ics") if p not in written)
    return stats


# ----------------------------------------------------------------- service


def connect(apple_id: str, session_dir: str) -> Any:
    """Return pyicloud's Reminders service using the saved session only.

    Never prompts: if the session has expired, say how to renew it.
    """
    try:
        from pyicloud import PyiCloudService
    except ImportError as err:
        raise UserError("pyicloud is not installed; run install.sh") from err
    api = PyiCloudService(apple_id, cookie_directory=session_dir, authenticate=False)
    status = api.get_auth_status()
    if not status.get("authenticated"):
        raise UserError("not signed in to iCloud (or the session expired). Run: abridge setup reminders")
    return api.reminders


def icloud_error(err: BaseException) -> bool:
    """pyicloud raises its own types for auth and CloudKit failures."""
    return type(err).__module__.startswith("pyicloud")


def can_follow_lists(svc: Any) -> bool:
    return hasattr(getattr(svc, "_reads", None), "_iter_zone_change_pages") and hasattr(svc, "_record_to_list")


def list_changes(svc: Any, token: str | None) -> tuple[list[Any], set[str], str | None]:
    """Lists added or changed since `token` (every list if None), the record
    names of records deleted since then, and the token to continue from.

    pyicloud has no public call for this: its lists() replays the zone's whole
    change history from the start, one ~1.4 s request per page and ~20 pages
    for a few hundred reminders. This drives the pager lists() is built on
    (pyicloud 2.7, pinned in lib/common.sh); can_follow_lists() checks it.
    """
    from pyicloud.common.cloudkit import CKErrorItem, CKRecord, CKTombstoneRecord

    changed: dict[str, Any] = {}
    gone: set[str] = set()
    for zone in svc._reads._iter_zone_change_pages(desired_record_types=["List"], sync_token=token):
        for rec in zone.records:
            if isinstance(rec, CKErrorItem):
                raise UserError(f"iCloud refused to list your lists: {rec.serverErrorCode} ({rec.reason})")
            if isinstance(rec, CKTombstoneRecord):
                gone.add(rec.recordName)
                changed.pop(rec.recordName, None)
            elif isinstance(rec, CKRecord) and rec.recordType == "List":
                reminder_list = svc._record_to_list(rec)
                changed[reminder_list.id] = reminder_list
                gone.discard(reminder_list.id)
        token = zone.syncToken
    return list(changed.values()), gone, token


class CachedLists:
    """pyicloud's Reminders service, with lists() served from a cache file
    that one small changes/zone request brings up to date.

    The whole list is fetched again when there's no usable cache, when iCloud
    rejects the token, and once a day.
    """

    def __init__(self, svc: Any, cache: Path | None, apple_id: str) -> None:
        self.svc = svc
        self.cache = cache
        self.apple_id = apple_id
        self._lists: list[Any] | None = None

    def __getattr__(self, name: str) -> Any:
        return getattr(self.svc, name)

    def lists(self) -> list[Any]:
        if self._lists is None:
            if self.cache is None or not can_follow_lists(self.svc):
                self._lists = list(self.svc.lists())
            else:
                self._lists = [SimpleNamespace(**l) for l in self._fetch()]
        return self._lists

    def _fetch(self) -> list[dict[str, Any]]:
        saved = read_json(self.cache)
        if (
            isinstance(saved, dict)
            and saved.get("apple_id") == self.apple_id
            and isinstance(saved.get("token"), str)
            and isinstance(saved.get("lists"), list)
            and time.time() - saved.get("full", 0) < FULL_REFRESH
        ):
            try:
                changed, gone, token = list_changes(self.svc, saved["token"])
            except Exception as err:  # noqa: BLE001
                if not icloud_error(err):
                    raise
                # Most likely an expired token: start again from scratch.
            else:
                by_id = {l["id"]: l for l in saved["lists"] if l.get("id") not in gone}
                for l in changed:
                    by_id[l.id] = {k: getattr(l, k) for k in LIST_FIELDS}
                return self._save(token, saved["full"], list(by_id.values()))
        changed, _, token = list_changes(self.svc, None)
        return self._save(token, time.time(), [{k: getattr(l, k) for k in LIST_FIELDS} for l in changed])

    def _save(self, token: str | None, full: float, lists: list[dict[str, Any]]) -> list[dict[str, Any]]:
        if token:
            data = {"apple_id": self.apple_id, "token": token, "full": full, "lists": lists}
            try:
                self.cache.parent.mkdir(parents=True, exist_ok=True)
                write_if_changed(self.cache, json.dumps(data, ensure_ascii=False))
            except OSError:
                pass  # the cache only saves time
        return lists


def live_lists(svc: Any) -> list[Any]:
    return [l for l in svc.lists() if not l.deleted and not l.is_group]


def reminders_in(svc: Any, reminder_list: Any, include_completed: bool) -> list[Any]:
    # results_limit is a page size; pyicloud follows continuation markers.
    result = svc.list_reminders(
        list_id=reminder_list.id, include_completed=include_completed, results_limit=200
    )
    return [r for r in result.reminders if not r.deleted]


def all_reminders(svc: Any, include_completed: bool) -> list[Any]:
    return [r for l in live_lists(svc) for r in reminders_in(svc, l, include_completed)]


class Finder:
    """Resolve ids to reminders. A full id (what the GUI sends) is one lookup;
    a short id needs every reminder, which is fetched once and reused."""

    def __init__(self, svc: Any) -> None:
        self.svc = svc
        self._pool: list[Any] | None = None

    def __call__(self, query: str) -> Any:
        q = bare_id(query.strip())
        if FULL_ID.fullmatch(q):
            try:
                return self.svc.get(f"{REMINDER_PREFIX}{q}")
            except LookupError:
                pass
        if self._pool is None:
            self._pool = all_reminders(self.svc, include_completed=True)
        return resolve_reminder(self._pool, query)


def iso(moment: datetime | None) -> str | None:
    return aware(moment).isoformat() if moment else None


def reminder_json(r: Any) -> dict[str, Any]:
    """The shape the Reminders app reads. Ids are bare (no 'Reminder/')."""
    return {
        "id": bare_id(r.id),
        "short": short_id(r.id),
        "list_id": bare_id(r.list_id or ""),
        "title": r.title or "",
        "notes": r.desc or "",
        "completed": bool(r.completed),
        "completed_date": iso(r.completed_date),
        "due": iso(r.due_date),
        "all_day": bool(r.all_day),
        "due_label": due_label(r),
        "priority": r.priority or 0,
        "flagged": bool(r.flagged),
        "parent_id": bare_id(r.parent_reminder_id) if r.parent_reminder_id else None,
        "created": iso(r.created),
        "modified": iso(r.modified),
    }


# ------------------------------------------------------------------ writes

APPLE_EPOCH = 978307200  # 2001-01-01 UTC, the epoch of ResolutionTokenMap times
TOPOTEXT = Path(__file__).resolve().with_name("abridge-topotext.mjs")


def token_key(field: str) -> str:
    """ResolutionTokenMap keys are the record's field names in lowerCamelCase."""
    return field[:1].lower() + field[1:]


def advance_tokens(tokens: dict[str, Any], fields: Iterable[str], now: float) -> dict[str, Any]:
    """The ResolutionTokenMap after changing `fields`: each of their counters
    goes up by one, and every other entry stays as it was.

    An entry ({counter, modificationTime, replicaID}) is how Apple's clients
    decide which change to a field is the newest. pyicloud replaces the whole
    map with counter 1 for each field it writes: to an iPhone that has
    counted 238 completions of a repeating reminder, that change looks older
    than the one it has, and the fields pyicloud doesn't know lose their
    entries. Apple's own records have a distinct random replicaID in every
    entry, so a new one is minted per change.
    """
    out = {key: dict(entry) for key, entry in tokens.items()}
    for field in fields:
        key = token_key(field)
        out[key] = {
            "counter": int(out.get(key, {}).get("counter", 0)) + 1,
            "modificationTime": now - APPLE_EPOCH,
            "replicaID": str(uuid.uuid4()).upper(),
        }
    return out


def decompress_document(value: str | bytes) -> bytes:
    """A TitleDocument/NotesDocument value: base64 text or bytes, gzip (the
    iPhone) or zlib (pyicloud) compressed."""
    data = value if isinstance(value, bytes) else base64.b64decode(value + "=" * (-len(value) % 4))
    for decompress in (gzip.decompress, zlib.decompress):
        try:
            return decompress(data)
        except (OSError, zlib.error):
            continue
    return data


class Writer:
    """Changes existing reminders the way Apple's own clients do: only the
    fields that changed, each with its ResolutionTokenMap entry advanced, and
    titles and notes edited as the CRDT documents they are
    (abridge-topotext.mjs).

    pyicloud's update() instead rewrites every field, restarts the token
    counters at 1, adds an empty NotesDocument to reminders that have none,
    and replaces the title and notes with brand-new documents under a fixed
    replica id. New reminders still go through pyicloud's create(), whose
    record matches the iPhone's own first save of a reminder.
    """

    def __init__(self, svc: Any, replica_file: Path | None, icloud_md: str | None) -> None:
        self.svc = svc
        self.replica_file = replica_file
        self.icloud_md = icloud_md

    def record(self, reminder: Any) -> Any:
        """The reminder's current CloudKit record (fields, change tag)."""
        from pyicloud.services.reminders._constants import _REMINDERS_ZONE_REQ

        name = f"{REMINDER_PREFIX}{bare_id(reminder.id)}"
        for rec in self.svc._raw.lookup(record_names=[name], zone_id=_REMINDERS_ZONE_REQ).records:
            if getattr(rec, "recordName", None) == name and getattr(rec, "fields", None) is not None:
                return rec
        raise UserError(f'"{reminder.title}" no longer exists in iCloud')

    def replica(self) -> bytes:
        """This computer's replica id for text edits: made once, then kept, so
        our edits continue our own clocks like any other device's."""
        if self.replica_file is None:
            raise UserError("no file to keep this computer's replica id in (ABRIDGE_REMINDERS_REPLICA)")
        try:
            value = base64.b64decode(self.replica_file.read_text().strip(), validate=True)
            if len(value) == 16:
                return value
        except (OSError, ValueError):
            pass
        value = os.urandom(16)
        self.replica_file.parent.mkdir(parents=True, exist_ok=True)
        self.replica_file.write_text(base64.b64encode(value).decode() + "\n")
        return value

    def text(self, rec: Any, field: str, text: str) -> dict[str, Any] | None:
        """The new value of TitleDocument or NotesDocument, or None when
        there's nothing to store (no document yet, and no text)."""
        current = rec.fields.get_value(field)
        if not current and not text:
            return None
        if not self.icloud_md:
            raise UserError("changing a reminder's title or notes needs icloud-md. Run install.sh")
        request = {
            "doc": base64.b64encode(decompress_document(current)).decode() if current else None,
            "text": text,
            "replica": base64.b64encode(self.replica()).decode(),
        }
        proc = subprocess.run(
            ["node", str(TOPOTEXT), self.icloud_md], input=json.dumps(request), capture_output=True, text=True
        )
        if proc.returncode != 0:
            raise UserError(f"could not edit the reminder's text: {proc.stderr.strip() or 'node failed'}")
        doc = base64.b64decode(json.loads(proc.stdout)["doc"])
        return {"type": "STRING", "value": base64.b64encode(gzip.compress(doc, mtime=0)).decode()}

    def save(self, rec: Any, fields: dict[str, dict[str, Any]], title: str) -> None:
        """Write `fields` (plus LastModifiedDate) to the record, if nothing
        changed it since we read it."""
        from pyicloud.common.cloudkit import CKErrorItem, CKModifyOperation, CKWriteRecord
        from pyicloud.services.reminders._constants import _REMINDERS_ZONE_REQ

        now = time.time()
        fields = {**fields, "LastModifiedDate": {"type": "TIMESTAMP", "value": int(now * 1000)}}
        current = json.loads(rec.fields.get_value("ResolutionTokenMap") or "{}")
        tokens = {**current, "map": advance_tokens(current.get("map", {}), list(fields), now)}
        fields["ResolutionTokenMap"] = {"type": "STRING", "value": json.dumps(tokens, separators=(",", ":"))}
        op = CKModifyOperation(
            operationType="update",
            record=CKWriteRecord(
                recordName=rec.recordName, recordType="Reminder", recordChangeTag=rec.recordChangeTag, fields=fields
            ),
        )
        for item in self.svc._raw.modify(operations=[op], zone_id=_REMINDERS_ZONE_REQ).records:
            if isinstance(item, CKErrorItem):
                if item.serverErrorCode == "CONFLICT":
                    raise UserError(f'"{title}" changed on another device just now; try again')
                raise UserError(f'iCloud refused the change to "{title}": {item.serverErrorCode} ({item.reason})')


def timestamp_ms(moment: datetime | None) -> int | None:
    return int(aware(moment).timestamp() * 1000) if moment else None


# ---------------------------------------------------------------- commands


def print_reminder(r: Any) -> None:
    box = "[x]" if r.completed else "[ ]"
    marks = ""
    if r.priority == 1:
        marks += " !!!"
    elif r.priority == 5:
        marks += " !!"
    elif r.priority == 9:
        marks += " !"
    if r.flagged:
        marks += " (flagged)"
    due = due_label(r)
    due = f"  due {due}" if due else ""
    indent = "    " if r.parent_reminder_id else "  "
    print(f"{indent}{box} {r.title}{marks}{due}  ({short_id(r.id)})")


def cmd_lists(svc: Any, args: argparse.Namespace) -> None:
    for l in live_lists(svc):
        print(f"{l.title}  ({l.count} open)")


def cmd_ls(svc: Any, args: argparse.Namespace) -> None:
    lists = live_lists(svc)
    if args.list:
        lists = [resolve_list(lists, args.list)]
    for l in lists:
        rows = reminders_in(svc, l, args.all)
        if not rows and not args.list:
            continue
        print(f"{l.title}")
        # Subtasks directly under their parent; everything else by due date.
        top = [r for r in rows if not r.parent_reminder_id]
        children: dict[str, list[Any]] = {}
        for r in rows:
            if r.parent_reminder_id:
                children.setdefault(r.parent_reminder_id, []).append(r)
        far = datetime.max.replace(tzinfo=timezone.utc)
        top.sort(key=lambda r: (r.completed, aware(r.due_date) if r.due_date else far, (r.title or "").casefold()))
        placed = set()
        for r in top:
            print_reminder(r)
            for c in children.get(r.id, []):
                print_reminder(c)
                placed.add(c.id)
        for r in rows:
            if r.parent_reminder_id and r.id not in placed:
                print_reminder(r)  # parent filtered out (e.g. completed)


def cmd_add(svc: Any, args: argparse.Namespace) -> None:
    target = resolve_list(live_lists(svc), args.list)
    due, all_day, tz_name = (None, False, None)
    if args.due:
        due, all_day, tz_name = parse_due(args.due)
    parent = None
    if args.parent:
        parent = resolve_reminder(reminders_in(svc, target, True), args.parent).id
    created = svc.create(
        list_id=target.id,
        title=args.title,
        desc=args.notes or "",
        due_date=due,
        priority=PRIORITIES[args.priority],
        flagged=args.flag,
        all_day=all_day,
        time_zone=tz_name,
        parent_reminder_id=parent,
    )
    print(f"added to {target.title}: {created.title}  ({short_id(created.id)})")


def set_completed(svc: Any, args: argparse.Namespace, completed: bool) -> None:
    find = Finder(svc)
    targets = [find(query) for query in args.ids]
    for r in targets:
        # The iPhone completes one occurrence and moves a repeating reminder
        # to its next date; written from here, Completed would end the series.
        if completed and not r.completed and getattr(r, "recurrence_rule_ids", None):
            raise UserError(f'"{r.title}" repeats: complete it on the iPhone, which moves it to its next date')
    for r in targets:
        label = "done" if completed else "not done"
        if bool(r.completed) == completed:
            print(f"already {label}: {r.title}  ({short_id(r.id)})")
            continue
        fields = {
            "Completed": {"type": "INT64", "value": 1 if completed else 0},
            "CompletionDate": {"type": "TIMESTAMP", "value": int(time.time() * 1000) if completed else None},
        }
        args.writer.save(args.writer.record(r), fields, r.title)
        print(f"{label}: {r.title}  ({short_id(r.id)})")


def cmd_rm(svc: Any, args: argparse.Namespace) -> None:
    find = Finder(svc)
    for r in [find(query) for query in args.ids]:
        args.writer.save(args.writer.record(r), {"Deleted": {"type": "INT64", "value": 1}}, r.title)
        print(f"deleted: {r.title}  ({short_id(r.id)})")


def cmd_edit(svc: Any, args: argparse.Namespace) -> None:
    r = Finder(svc)(args.id)
    if args.title is not None and not args.title.strip():
        raise UserError("the title cannot be empty")
    rec = args.writer.record(r)
    # Only what actually changes is written: the app sends every field.
    fields: dict[str, dict[str, Any]] = {}
    if args.title is not None and args.title != (r.title or ""):
        fields["TitleDocument"] = args.writer.text(rec, "TitleDocument", args.title)
    if args.notes is not None and args.notes != (r.desc or ""):
        notes = args.writer.text(rec, "NotesDocument", args.notes)
        if notes:
            fields["NotesDocument"] = notes
    if args.no_due or args.due:
        due, all_day, tz_name = (None, False, None) if args.no_due else parse_due(args.due)
        if timestamp_ms(due) != timestamp_ms(r.due_date):
            fields["DueDate"] = {"type": "TIMESTAMP", "value": timestamp_ms(due)}
        if all_day != bool(r.all_day):
            fields["AllDay"] = {"type": "INT64", "value": 1 if all_day else 0}
        if tz_name != (r.time_zone or None):
            fields["TimeZone"] = {"type": "STRING", "value": tz_name}
    if args.priority and PRIORITIES[args.priority] != (r.priority or 0):
        fields["Priority"] = {"type": "INT64", "value": PRIORITIES[args.priority]}
    if args.flag is not None and args.flag != bool(r.flagged):
        fields["Flagged"] = {"type": "INT64", "value": 1 if args.flag else 0}
    title = args.title if "TitleDocument" in fields else r.title
    if not fields:
        print(f"unchanged: {title}  ({short_id(r.id)})")
        return
    args.writer.save(rec, fields, r.title)
    print(f"updated: {title}  ({short_id(r.id)})")


def cmd_dump(svc: Any, args: argparse.Namespace) -> None:
    out: dict[str, Any] = {"lists": [], "reminders": []}
    for l in live_lists(svc):
        rows = reminders_in(svc, l, args.completed)
        out["lists"].append(
            {
                "id": bare_id(l.id),
                "title": l.title,
                "color": list_color(l.color),
                "open": sum(1 for r in rows if not r.completed),
            }
        )
        out["reminders"].extend(reminder_json(r) for r in rows)
    json.dump(out, sys.stdout, ensure_ascii=False)
    print()


def cmd_mirror(svc: Any, args: argparse.Namespace) -> None:
    dest = Path(args.dest).expanduser()
    lists = live_lists(svc)
    saved = read_json(dest / MIRROR_STATE)
    # Take the token first: anything that changes while we read is then
    # fetched again next time, rather than missed.
    token = svc.sync_cursor()
    stats = None
    if (
        isinstance(saved, dict)
        and saved.get("apple_id") == args.apple_id
        and isinstance(saved.get("token"), str)
        and time.time() - saved.get("full", 0) < FULL_REFRESH
        and (dest / MIRROR_MARKER).exists()
    ):
        try:
            changes = list(svc.iter_changes(since=saved["token"]))
        except Exception as err:  # noqa: BLE001
            if not icloud_error(err):
                raise
        else:
            stats = mirror_changes(lists, changes, dest, lambda l: reminders_in(svc, l, True))
            full = saved["full"]
    if stats is None:
        stats = mirror([(l, reminders_in(svc, l, True)) for l in lists], dest)
        full = time.time()
    write_if_changed(dest / MIRROR_STATE, json.dumps({"apple_id": args.apple_id, "token": token, "full": full}))
    print(
        f"reminders mirror: {stats['lists']} lists, {stats['written']} written, "
        f"{stats['unchanged']} unchanged, {stats['removed']} removed -> {args.dest}"
    )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="abridge rem", description=__doc__.split("\n\n")[0])
    p.add_argument("--apple-id", default=os.environ.get("APPLE_ID"))
    p.add_argument("--session-dir", default=os.environ.get("ABRIDGE_PYICLOUD_SESSION"))
    p.add_argument("--cache", default=os.environ.get("ABRIDGE_REMINDERS_CACHE"), help="file to cache your lists in")
    p.add_argument(
        "--replica-file", default=os.environ.get("ABRIDGE_REMINDERS_REPLICA"), help="file keeping this computer's replica id"
    )
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("lists", help="show your lists").set_defaults(func=cmd_lists)

    ls = sub.add_parser("ls", help="show reminders, grouped by list")
    ls.add_argument("list", nargs="?", help="list name (or the start of it)")
    ls.add_argument("-a", "--all", action="store_true", help="include completed")
    ls.set_defaults(func=cmd_ls)

    add = sub.add_parser("add", help="add a reminder")
    add.add_argument("list", help="list name (or the start of it)")
    add.add_argument("title")
    add.add_argument("-d", "--due", help='YYYY-MM-DD, "YYYY-MM-DD HH:MM", today, tomorrow')
    add.add_argument("-n", "--notes")
    add.add_argument("-p", "--priority", choices=list(PRIORITIES), default="none")
    add.add_argument("-f", "--flag", action="store_true")
    add.add_argument("--parent", help="id of the reminder to nest this under")
    add.set_defaults(func=cmd_add)

    done = sub.add_parser("done", help="mark reminders completed")
    done.add_argument("ids", nargs="+", metavar="ID")
    done.set_defaults(func=lambda s, a: set_completed(s, a, True))

    undo = sub.add_parser("undo", help="mark reminders not completed")
    undo.add_argument("ids", nargs="+", metavar="ID")
    undo.set_defaults(func=lambda s, a: set_completed(s, a, False))

    rm = sub.add_parser("rm", help="delete reminders (they go to Recently Deleted)")
    rm.add_argument("ids", nargs="+", metavar="ID")
    rm.set_defaults(func=cmd_rm)

    edit = sub.add_parser("edit", help="change a reminder")
    edit.add_argument("id", metavar="ID")
    edit.add_argument("-t", "--title")
    edit.add_argument("-n", "--notes")
    due = edit.add_mutually_exclusive_group()
    due.add_argument("-d", "--due", help='YYYY-MM-DD, "YYYY-MM-DD HH:MM", today, tomorrow')
    due.add_argument("--no-due", action="store_true", help="remove the due date")
    edit.add_argument("-p", "--priority", choices=list(PRIORITIES))
    edit.add_argument("-f", "--flag", action=argparse.BooleanOptionalAction, default=None)
    edit.set_defaults(func=cmd_edit)

    dump = sub.add_parser("dump", help="every list and reminder as JSON (for the app)")
    dump.add_argument("--completed", action="store_true", help="include completed reminders")
    dump.set_defaults(func=cmd_dump)

    mir = sub.add_parser("mirror", help="write every reminder to a vdir of .ics files")
    mir.add_argument("dest", nargs="?", default=os.environ.get("REMINDERS_DIR"))
    mir.set_defaults(func=cmd_mirror)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if not args.apple_id:
            raise UserError("APPLE_ID is not set. Run: abridge init")
        if not args.session_dir:
            raise UserError("no pyicloud session directory given")
        if args.command == "mirror" and not args.dest:
            raise UserError("no destination for the mirror (REMINDERS_DIR)")
        svc = connect(args.apple_id, args.session_dir)
        cache = Path(args.cache).expanduser() if args.cache else None
        replica = Path(args.replica_file).expanduser() if args.replica_file else None
        args.writer = Writer(svc, replica, os.environ.get("ABRIDGE_ICLOUD_MD_PKG"))
        args.func(CachedLists(svc, cache, args.apple_id), args)
    except UserError as err:
        print(f"error: {err}", file=sys.stderr)
        return 1
    except Exception as err:  # noqa: BLE001
        # Show iCloud failures as one line. Anything else is a bug here: keep
        # the traceback.
        if not icloud_error(err):
            raise
        print(f"iCloud error: {err}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
